# Practice mode needs no keys. Live AI also needs the server-only keys below.
# Never put model credentials in NEXT_PUBLIC_* variables.

# Authenticated owner workspace (Supabase project yfmoggubjsffgameexfi).
NEXT_PUBLIC_SUPABASE_URL=https://yfmoggubjsffgameexfi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The browser and server use the signed-in user's session for tenant content so
# database RLS stays active. The secret key below is only for server-owned tables.

# --- Live AI (server-only, never NEXT_PUBLIC_) ---
# Live AI stays off until both keys are set AND the owner turns it on in Settings.
OPENAI_API_KEY=
# Supabase > Project Settings > API Keys > Secret key. Used only by the server
# for the usage ledger and workspace limits (bypasses RLS; never expose it).
SUPABASE_SECRET_KEY=
# Optional
OPENAI_MODEL=gpt-4o-mini
# Prices used for budget accounting (USD per 1M tokens); defaults are conservative.
# OPENAI_INPUT_USD_PER_MTOK=0.15
# OPENAI_OUTPUT_USD_PER_MTOK=0.60
# OPENAI_MAX_OUTPUT_TOKENS=1200
# HELLOCREW_PLATFORM_MONTHLY_CAP_USD=20

# --- Owner email alerts (optional, server-only) ---
# Resend (resend.com) API key. Without it, alerts stay off; settings are kept.
RESEND_API_KEY=
# Sender, from a domain verified in Resend. Until then Resend's test sender
# only delivers to your own Resend account email.
# NOTIFY_FROM=HelloCrew <alerts@yourdomain.com>

# --- Connected accounts (server-only; never NEXT_PUBLIC_) ---
# 32-byte key that encrypts each business's Meta/Google tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HELLOCREW_ENCRYPTION_KEY=

# Meta app (Facebook, Messenger, Instagram, WhatsApp). See docs/CHANNELS_SETUP.md
META_APP_ID=
META_APP_SECRET=
# Any long random string; paste the same value into the Meta webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_VERSION=v25.0

# Google Business Profile (reviews)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Vercel Cron sends this as a Bearer token to /api/cron/google-reviews.
CRON_SECRET=
